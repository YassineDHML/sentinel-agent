# Sentinel secrets — copy this file to `.env` and fill in real values.
# NEVER commit `.env`. In CI these are provided as GitHub Secrets, not from a file.
# Placeholder names only below; no real values.

# --- LLM ---
GEMINI_API_KEY=            # Google AI Studio API key (Gemini, free tier)
GROQ_API_KEY=              # Groq API key (fallback LLM)

# --- News / source APIs ---
GNEWS_API_KEY=             # GNews free tier (discovery layer)
PRODUCTHUNT_TOKEN=         # Product Hunt GraphQL API token

# --- Persistence (Supabase) ---
SUPABASE_URL=              # e.g. https://<project-ref>.supabase.co
SUPABASE_KEY=              # Supabase API key (service_role or anon, per Phase 1 decision)

# --- Email delivery (Gmail SMTP) ---
GMAIL_ADDRESS=             # sending Gmail address
GMAIL_APP_PASSWORD=        # Gmail *app password* (requires 2FA); NOT your account password

# --- Slack delivery (optional) ---
SLACK_WEBHOOK_URL=         # Slack incoming webhook URL

# --- Misc (optional) ---
LOG_LEVEL=INFO             # overrides app.log_level from config.yaml
